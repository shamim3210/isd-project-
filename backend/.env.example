MONGO_URI=mongodb://127.0.0.1:27017/libraryms
PORT=5000
JWT_SECRET=change_this_secret_key

# Required to let anyone register as a Librarian. Set this to a secret
# phrase only you know, and share it privately with real librarians you
# want to onboard (e.g. tell them in person or via a private message) —
# never post it publicly. Leave this blank to disable librarian
# self-registration entirely; you can still promote a student to librarian
# or admin later via PATCH /api/users/:id/role (admin-only).
LIBRARIAN_SIGNUP_CODE=change_this_to_a_secret_phrase

# Email (Gmail SMTP) — used for verification, password reset, and notifications.
# In your Google Account: Security → 2-Step Verification → App Passwords → generate one for "Mail".
# Use that 16-character app password below, NOT your normal Gmail password.
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="LibraryMS <youraddress@gmail.com>"

# Your deployed (or local) frontend URL — used to build links inside emails
APP_URL=http://localhost:3000

# Optional — enables the real AI chatbot (Anthropic Claude). Get a key at
# https://console.anthropic.com. Without this, the chatbot still works but
# only answers a handful of hardcoded FAQ questions instead of understanding
# free-form questions and searching the catalog for real answers.
ANTHROPIC_API_KEY=

# Optional — enables online fine payment via bKash (sandbox, no real money).
# Sign up free at https://developer.bka.sh, create an app, and paste your
# sandbox credentials below. Without these, students see "pay at the desk"
# and librarians keep using the existing "mark fine as paid" button.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
